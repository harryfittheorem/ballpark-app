modules = ["nodejs-20", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", "package-lock.json", "node_modules"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["npm", "--prefix", "portal", "run", "start"]
deploymentTarget = "autoscale"
build = ["npm", "--prefix", "portal", "run", "build"]

[env]
PATH = "/home/runner/$REPL_SLUG/.config/npm/node_global/bin:/home/runner/$REPL_SLUG/node_modules/.bin"
npm_config_prefix = "/home/runner/$REPL_SLUG/.config/npm/node_global"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[languages]

[languages.typescript]
pattern = "**/{*.ts,*.tsx}"

[languages.typescript.languageServer]
start = "typescript-language-server --stdio"

[[ports]]
localPort = 3000
externalPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 5173

[[ports]]
localPort = 3003
externalPort = 8000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 6000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 19000
externalPort = 3000

[[ports]]
localPort = 19001
externalPort = 3001

[[ports]]
localPort = 19002
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 6800

# When in shell, start a Bash environment by default
[interpreter]
command = ["bash"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
EXPO_PUBLIC_SUPABASE_URL = "https://exjcwvvglthnxerzpukw.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY = "sb_publishable_xyXVBy2HN2pvbDTZC15jQQ_et3pskXc"
EXPO_PUBLIC_TENANT_SLUG = "infinitehitting"
RESEND_FROM_EMAIL = "noreply@email.fittcoaching.ai"
PORTAL_TENANT_ID = "00000000-0000-0000-0000-000000000001"

[userenv.production]
NEXT_PUBLIC_PORTAL_URL = "https://ballpark-app.replit.app"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo dev (proxy)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Portal dev"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pitch Deck"

[[workflows.workflow]]
name = "Expo dev (proxy)"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_PACKAGER_PROXY_URL=\"https://$REPLIT_DEV_DOMAIN\" EXPO_MANIFEST_PROXY_URL=\"https://$REPLIT_DEV_DOMAIN\" npx expo start --port 8080 < /dev/null"

[[workflows.workflow]]
name = "Portal dev"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd portal && npm run dev -- -p 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Pitch Deck"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/pitch-deck && ./node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0 --port 3001"
waitForPort = 3001
