{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true
    },
    "production-infinitehitting": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "infinitehitting"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6773873454"
      }
    }
  }
}
